<?xml version="1.0" encoding="utf-8"?>
<!-- Receiver TV: setup D-pad-first, safe area 48dp, video fullscreen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A11"
    android:keepScreenOn="true">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/video_renderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/panel_setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_receiver"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="40dp"
        android:paddingEnd="48dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_brand_mark"
                android:gravity="center"
                android:text="W"
                android:textColor="#06111C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="#EAF2F8"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/setup_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:background="@drawable/bg_status_chip"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#52D3C6"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="34dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="52dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECEIVER MODE"
                    android:textColor="#52D3C6"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/setup_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:text="Siap menerima\nlayar laptop"
                    android:textColor="#EAF2F8"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/setup_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="3"
                    android:text="Pastikan TV dan laptop berada di jaringan yang sama. Buka WDT Sender, lalu gunakan kode pairing yang tampil di laptop."
                    android:textColor="#AFC0CF"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="01   Buka WDT Sender di laptop"
                        android:textColor="#DCE8F1"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="02   Masukkan kode pairing 6 digit"
                        android:textColor="#DCE8F1"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="03   Pilih laptop yang ditemukan"
                        android:textColor="#DCE8F1"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:layout_width="520dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_setup_panel"
                android:fillViewport="true"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:padding="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sambungkan laptop"
                        android:textColor="#EAF2F8"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Masukkan kode yang terlihat di Sender."
                        android:textColor="#96AABC"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="KODE PAIRING"
                        android:textColor="#B9CAD8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/token_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/selector_input"
                        android:digits="0123456789"
                        android:gravity="center_vertical"
                        android:hint="000000"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="6"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:singleLine="true"
                        android:textColor="#EAF2F8"
                        android:textColorHint="#93A9BC"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/discovery_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:textColor="#AFC0CF"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/sender_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/btn_retry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/selector_secondary_button"
                        android:focusable="true"
                        android:textAllCaps="false"
                        android:textColor="@color/selector_secondary_text"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btn_manual_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/selector_tertiary_button"
                        android:focusable="true"
                        android:text="Laptop tidak ditemukan?"
                        android:textAllCaps="false"
                        android:textColor="@color/selector_secondary_text"
                        android:textSize="15sp" />

                    <CheckBox
                        android:id="@+id/chk_low_latency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="10dp"
                        android:focusable="true"
                        android:textColor="#EAF2F8"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/manual_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/manual_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#B9CAD8"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/manual_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="60dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/selector_input"
                            android:hint="@string/manual_input_hint"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:singleLine="true"
                            android:textColor="#EAF2F8"
                            android:textColorHint="#93A9BC"
                            android:textSize="16sp" />

                        <Button
                            android:id="@+id/btn_connect_manual"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="60dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/selector_primary_button"
                            android:focusable="true"
                            android:textAllCaps="false"
                            android:textColor="@color/selector_primary_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/session_panel"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_session_panel"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#52D3C6"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/session_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE"
                android:textColor="#46A7FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_hide_session"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/selector_tertiary_button"
                android:contentDescription="Sembunyikan panel sesi"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="×"
                android:textAllCaps="false"
                android:textColor="@color/selector_secondary_text"
                android:textSize="23sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/sender_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#DCE8F1"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tier_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#8DA3B6"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/audio_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#52D3C6"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/stats_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#F2B84B"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Tekan OK untuk menampilkan panel ini lagi."
            android:textColor="#7E94A6"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_disconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                        android:minHeight="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/selector_secondary_button"
            android:focusable="true"
            android:text="Putuskan koneksi"
            android:textAllCaps="false"
            android:textColor="@color/selector_secondary_text"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>
