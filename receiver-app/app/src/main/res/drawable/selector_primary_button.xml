<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#7CDBD2" /><stroke android:width="3dp" android:color="#EAF2F8" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#3BBEB1" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#52D3C6" /><corners android:radius="14dp" /></shape>
    </item>
</selector>
